# Server port
PORT=

# CORS allowed origin (the Next.js frontend). Use * to allow all during local dev.
CORS_ORIGIN=

# Maximum upload size in megabytes (matches the frontend's 50 MB notice)
MAX_UPLOAD_MB=

# Conversion timeout in milliseconds
CONVERSION_TIMEOUT_MS=

# Maximum number of concurrent conversions
MAX_CONCURRENT_CONVERSIONS=

# Optional: override the python executable inside the venv.
# Leave unset to auto-detect backend/python/venv.
# PYTHON_BIN=
